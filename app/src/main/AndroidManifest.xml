<?xml version="1.0" encoding="utf-8"?>
<!--
  렉스턴 차량모드. 권한 없음(인터넷·위치·접근성·백그라운드 서비스 모두 없음).
  하는 일: 큰 가로 화면에서 네비/음악/유튜브 앱을 대신 실행해 주는 런처일 뿐.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 11+ 패키지 가시성. QUERY_ALL_PACKAGES 는 쓰지 않는다.
      - 아래 package 목록: 각 칸의 후보 앱 (설치돼 있는지, 아이콘/이름 읽기, 실행 인텐트 얻기)
      - MAIN/LAUNCHER intent: "기타 앱 고르기" 목록(홈 화면에 아이콘이 있는 앱 전부)
    -->
    <queries>
        <!-- 네비 -->
        <package android:name="com.skt.tmap.ku" />
        <package android:name="com.locnall.KimGiSa" />
        <package android:name="com.nhn.android.nmap" />
        <package android:name="net.daum.android.map" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="kr.mappers.AtlanSmart" />
        <!-- 음악 -->
        <package android:name="com.iloen.melon" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.ktmusic.geniemusic" />
        <package android:name="com.spotify.music" />
        <package android:name="skplanet.musicmate" />
        <package android:name="com.neowiz.android.bugs" />
        <package android:name="com.sec.android.app.music" />
        <!-- 유튜브 -->
        <package android:name="com.google.android.youtube" />
        <package android:name="app.revanced.android.youtube" />
        <!-- 삼성 Smart View (화면 미러링) -->
        <package android:name="com.samsung.android.smartmirroring" />

        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/CarTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
